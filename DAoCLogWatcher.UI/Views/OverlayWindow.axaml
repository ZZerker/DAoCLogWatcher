<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DAoCLogWatcher.UI.ViewModels"
        x:Class="DAoCLogWatcher.UI.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="DAoC Overlay"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight">

    <Border Background="{Binding CardBackground}"
            CornerRadius="8"
            MinWidth="200"
            Padding="0">
        <StackPanel>

            <!-- Header strip (drag + opacity + reset + lock) — only visible while unlocked -->
            <Grid x:Name="HeaderStrip"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  Background="#20FFFFFF"
                  Height="26"
                  IsVisible="{Binding !IsLocked}"
                  PointerPressed="OnHeaderPointerPressed"
                  PointerReleased="OnHeaderPointerReleased">
                <TextBlock Grid.Column="0"
                           Text="Drag to move"
                           FontSize="10"
                           Foreground="{DynamicResource AppOverlayTextMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0" />
                <Slider Grid.Column="1"
                        Width="80"
                        Minimum="0.2" Maximum="1"
                        Value="{Binding BackgroundOpacity}"
                        ToolTip.Tip="Background opacity"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0" />
                <Button Grid.Column="2"
                        Command="{Binding ResetCommand}"
                        ToolTip.Tip="Reset to defaults (opacity + position)"
                        Classes="btn-icon"
                        Width="22" Height="22"
                        Padding="0"
                        Margin="0,0,2,0">
                    <Viewbox Width="12" Height="12">
                        <!-- Phosphor "arrow-counter-clockwise" (bold), MIT, 256 unit grid -->
                        <Canvas Width="256" Height="256">
                            <Path Fill="White"
                                  Data="M228,128a100,100,0,0,1-98.66,100H128a99.39,99.39,0,0,1-68.62-27.29,12,12,0,0,1,16.48-17.45,76,76,0,1,0-1.57-109c-.13.13-.25.25-.39.37L54.89,92H72a12,12,0,0,1,0,24H24a12,12,0,0,1-12-12V56a12,12,0,0,1,24,0V76.72L57.48,57.06A100,100,0,0,1,228,128Z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding ToggleLockCommand}"
                        ToolTip.Tip="Lock overlay (click-through)"
                        Classes="btn-icon"
                        Width="22" Height="22"
                        Padding="0"
                        Margin="0,0,2,0">
                    <Viewbox Width="12" Height="12">
                        <!-- Phosphor "lock-open" (bold), MIT, 256 unit grid. Header is hidden while locked, so only the open state is ever shown. -->
                        <Canvas Width="256" Height="256">
                            <Path Fill="White"
                                  Data="M208,76H100V56a28,28,0,0,1,28-28c13.51,0,25.65,9.62,28.24,22.39a12,12,0,1,0,23.52-4.78C174.87,21.5,153.1,4,128,4A52.06,52.06,0,0,0,76,56V76H48A20,20,0,0,0,28,96V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V96A20,20,0,0,0,208,76Zm-4,128H52V100H204Zm-92-52a16,16,0,1,1,16,16A16,16,0,0,1,112,152Z" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <StackPanel Margin="12,10" Spacing="6">

                <!-- Character + live dot -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource AppOverlayAccent}"
                             IsVisible="{Binding IsLive}" />
                    <TextBlock Text="{Binding CharacterName}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppOverlayText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- RP total + RP/hr -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowRp}">
                    <TextBlock Text="{Binding Summary.TotalRealmPoints}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AppOverlayAccent}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="RP" FontSize="11"
                               Foreground="{DynamicResource AppOverlayTextMuted}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.RpsPerHour, StringFormat={}{0:N0}/hr}"
                               FontSize="12"
                               Foreground="{DynamicResource AppOverlayAccentPurple}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Damage / Heal (bigger total first) -->
                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CombatRowVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding PrimaryVisible}">
                        <TextBlock Text="{Binding PrimaryLabel}" FontSize="11"
                                   Foreground="{Binding PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PrimaryValue}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding SecondaryVisible}">
                        <TextBlock Text="{Binding SecondaryLabel}" FontSize="11"
                                   Foreground="{Binding SecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SecondaryValue}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding SecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Kill feed -->
                <ItemsControl ItemsSource="{Binding KillFeed}" IsVisible="{Binding ShowKillFeed}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppOverlayTextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Player message -->
                <Border IsVisible="{Binding SendNotification.IsVisible}"
                        Background="{DynamicResource AppOverlayMessageBg}"
                        BorderBrush="{DynamicResource AppOverlayAccent}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4"
                        Padding="6,4"
                        MaxWidth="260">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding SendNotification.Sender}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppOverlayAccent}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SendNotification.Message}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppOverlayText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
