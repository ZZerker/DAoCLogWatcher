<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAoCLogWatcher.UI.ViewModels"
             xmlns:scott="using:ScottPlot.Avalonia"
             xmlns:controls="using:DAoCLogWatcher.UI.Controls"
             x:Class="DAoCLogWatcher.UI.Views.Tabs.KillHeatmapTabView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*" Margin="10,10,10,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <StackPanel Spacing="4">
                <TextBlock Text="Kill Activity Heatmap" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimary}" />
                <TextBlock
                    Text="Hot zones in the active window — color intensity shows relative kill density"
                    FontSize="12" Foreground="{DynamicResource AppTextMuted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="ShowHeatmapToggle" Classes="btn-toggle" Content="Heatmap" />
                    <ToggleButton x:Name="ShowFightsToggle" Classes="btn-toggle" Content="Fights" />
                    <ToggleButton x:Name="ShowGroupsToggle" Classes="btn-toggle" Content="Groups" />
                    <ToggleButton x:Name="ShowEventsToggle" Classes="btn-toggle" Content="Events" />
                    <ToggleButton x:Name="ShowRelicsToggle" Classes="btn-toggle" Content="Relics" />
                </StackPanel>
                <TextBlock
                    Text="{Binding ZoneActivity.RecentZoneKillCount, StringFormat='Total: {0} kills'}"
                    Foreground="{DynamicResource AppTextSecondary}" FontSize="13"
                    VerticalAlignment="Center" />
                <ComboBox Width="140"
                          ItemsSource="{Binding ZoneActivity.ZoneKillWindowOptions}"
                          SelectedItem="{Binding ZoneActivity.SelectedZoneKillWindow}"
                          FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        <Panel Grid.Row="1">
            <controls:AspectRatioPanel Ratio="0.91667"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,2,0,0">
                <scott:AvaPlot x:Name="KillHeatmapPlot" />
            </controls:AspectRatioPanel>
            <Border x:Name="RelicPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="2" Padding="9,7" CornerRadius="6"
                    Background="{DynamicResource AppCardBackground}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="RELICS" FontSize="11" FontWeight="Bold" LetterSpacing="1"
                               Foreground="{DynamicResource AppTextMuted}" />
                    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto"
                          ColumnSpacing="5" RowSpacing="5">
                            <Border Grid.Row="0" Grid.Column="0" x:Name="RelicAlbStr" Width="48" Height="48"
                                    CornerRadius="4" BorderThickness="3"
                                    BorderBrush="{DynamicResource AppRealmUnknown}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="avares://DAoCLogWatcher.UI/Assets/map/relic_albstr.jpg" Stretch="UniformToFill" />
                                    <Border x:Name="RelicAlbStrTint"
                                            Background="{DynamicResource AppRealmUnknownWash}" />
                                </Panel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" x:Name="RelicHibStr" Width="48" Height="48"
                                    CornerRadius="4" BorderThickness="3"
                                    BorderBrush="{DynamicResource AppRealmUnknown}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="avares://DAoCLogWatcher.UI/Assets/map/relic_hibstr.jpg" Stretch="UniformToFill" />
                                    <Border x:Name="RelicHibStrTint"
                                            Background="{DynamicResource AppRealmUnknownWash}" />
                                </Panel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" x:Name="RelicMidStr" Width="48" Height="48"
                                    CornerRadius="4" BorderThickness="3"
                                    BorderBrush="{DynamicResource AppRealmUnknown}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="avares://DAoCLogWatcher.UI/Assets/map/relic_midstr.jpg" Stretch="UniformToFill" />
                                    <Border x:Name="RelicMidStrTint"
                                            Background="{DynamicResource AppRealmUnknownWash}" />
                                </Panel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" x:Name="RelicAlbMagic" Width="48" Height="48"
                                    CornerRadius="4" BorderThickness="3"
                                    BorderBrush="{DynamicResource AppRealmUnknown}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="avares://DAoCLogWatcher.UI/Assets/map/relic_albmagic.jpg" Stretch="UniformToFill" />
                                    <Border x:Name="RelicAlbMagicTint"
                                            Background="{DynamicResource AppRealmUnknownWash}" />
                                </Panel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" x:Name="RelicHibMagic" Width="48" Height="48"
                                    CornerRadius="4" BorderThickness="3"
                                    BorderBrush="{DynamicResource AppRealmUnknown}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="avares://DAoCLogWatcher.UI/Assets/map/relic_hibmagic.jpg" Stretch="UniformToFill" />
                                    <Border x:Name="RelicHibMagicTint"
                                            Background="{DynamicResource AppRealmUnknownWash}" />
                                </Panel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" x:Name="RelicMidMagic" Width="48" Height="48"
                                    CornerRadius="4" BorderThickness="3"
                                    BorderBrush="{DynamicResource AppRealmUnknown}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="avares://DAoCLogWatcher.UI/Assets/map/relic_midmagic.jpg" Stretch="UniformToFill" />
                                    <Border x:Name="RelicMidMagicTint"
                                            Background="{DynamicResource AppRealmUnknownWash}" />
                                </Panel>
                            </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Canvas x:Name="TooltipCanvas" IsHitTestVisible="False">
                <Border x:Name="BurnTooltip" IsVisible="False"
                        Background="#CC1E1E1E" BorderBrush="#FF6600" BorderThickness="1"
                        CornerRadius="3" Padding="7,4,7,5">
                    <TextBlock x:Name="BurnTooltipText" Foreground="#FFFFFF" FontSize="12" />
                </Border>
            </Canvas>
        </Panel>
    </Grid>
</UserControl>